="335" y="306" as="sourcePoint"/><mxPoint x="125" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선n6" value="여기서 응답이 확정된다.&lt;br&gt;이 뒤에 무엇이 실패해도 사용자는 알 수 없다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#F0FBF3;strokeColor=#6DB33F;fontSize=11;fontColor=#24292E;" vertex="1" parent="1"><mxGeometry x="1530" y="285" width="340" height="42" as="geometry"/></mxCell><mxCell id="개선d7" value="트랜잭션 커밋" style="html=1;endArrow=none;dashed=1;dashPattern=8 8;strokeColor=#9AA5B1;fontColor=#9AA5B1;fontSize=11;fontStyle=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="350" as="sourcePoint"/><mxPoint x="1480" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e8" value="[AFTER_COMMIT] ComposeRequestedEvent  →  @Async 큐에 적재" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#C53030;fontColor=#C53030;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="394" as="sourcePoint"/><mxPoint x="965" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선n9" value="유실 ① 큐 상한 초과&lt;br&gt;RejectedExecutionException 이 터지지만&lt;br&gt;요청은 이미 202 를 받고 나간 뒤라 응답에 안 실린다.&lt;br&gt;상태를 바꾸는 곳이 리스너뿐이라 → 영구 PENDING" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#FFF0F0;strokeColor=#C53030;fontSize=11;fontColor=#24292E;" vertex="1" parent="1"><mxGeometry x="1530" y="357" width="340" height="74" as="geometry"/></mxCell><mxCell id="개선e10" value="claim: UPDATE started_at  (영향 행 1이면 획득)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#9AA5B1;fontColor=#9AA5B1;fontSize=11;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="438" as="sourcePoint"/><mxPoint x="755" y="438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e11" value="invoke( InvocationType.RequestResponse )" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#9AA5B1;fontColor=#9AA5B1;fontSize=11;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="482" as="sourcePoint"/><mxPoint x="1175" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선n12" value="합성 1건 8.3초 중 7.9초가 Lambda 안.&lt;br&gt;그동안 워커 스레드는 소켓에서 대기만 한다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#FAFAFA;strokeColor=#9AA5B1;fontSize=11;fontColor=#24292E;" vertex="1" parent="1"><mxGeometry x="1530" y="461" width="340" height="42" as="geometry"/></mxCell><mxCell id="개선e13" value="(정상) 결과 payload" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#6DB33F;fontColor=#6DB33F;fontSize=11;strokeWidth=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="526" as="sourcePoint"/><mxPoint x="965" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e14" value="UPDATE status = DONE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#6DB33F;fontColor=#6DB33F;fontSize=11;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="570" as="sourcePoint"/><mxPoint x="755" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선d15" value="동시성 한도(10)를 넘긴 요청은 다른 길로 간다" style="html=1;endArrow=none;dashed=1;dashPattern=8 8;strokeColor=#C53030;fontColor=#C53030;fontSize=11;fontStyle=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="614" as="sourcePoint"/><mxPoint x="1480" y="614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e16" value="429 Rate Exceeded  (대기가 아니라 예외)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#C53030;fontColor=#C53030;fontSize=11;strokeWidth=2;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="658" as="sourcePoint"/><mxPoint x="965" y="658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e17" value="UPDATE status = FAILED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#C53030;fontColor=#C53030;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="702" as="sourcePoint"/><mxPoint x="755" y="702" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선n18" value="유실 ② 429 가 FAILED 로 확정된다.&lt;br&gt;재시도 가능한 실패인데 영구 실패로 기록된다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#FFF0F0;strokeColor=#C53030;fontSize=11;fontColor=#24292E;" vertex="1" parent="1"><mxGeometry x="1530" y="681" width="340" height="42" as="geometry"/></mxCell><mxCell id="개선e19" value="findStalled( status = PENDING )" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#9AA5B1;fontColor=#9AA5B1;fontSize=11;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385" y="746" as="sourcePoint"/><mxPoint x="755" y="746" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선e20" value="FAILED 는 조회 조건 밖 → 회수 대상 0건" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#C53030;fontColor=#C53030;fontSize=11;strokeWidth=2;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="790" as="sourcePoint"/><mxPoint x="1385" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="개선n21" value="두 유실 모두 아무도 줍지 않는다.&lt;br&gt;멱등키로 재요청해도 기존 Job 을 그대로 돌려받아&lt;br&gt;새 실행이 일어나지 않는다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#FFF0F0;strokeColor=#C53030;fontSize=11;fontColor=#24292E;" vertex="1" parent="1"><mxGeometry x="1530" y="761" width="340" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="개선 후 - 비동기 + SQS" id="개선_후_-_비동기_+_SQS"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides=
# 하루컷 운영 서버 환경변수
# 서버에서 compose.yml 과 같은 폴더에 .env 로 복사한 뒤 값을 채운다.
# ⚠️ 값을 채우는 순간 자격증명 파일이다. 커밋 금지 (.gitignore 의 .env 가 막고 있다)

# ── 이미지 ────────────────────────────────────────────────────
# CI 가 배포할 때 커밋 SHA 로 바꿔 쓴다. 롤백은 이 값을 이전 SHA 로 되돌리고 up -d
IMAGE_TAG=latest

# ── DB ────────────────────────────────────────────────────────
# MySQL 컨테이너가 첫 기동 때 이 값으로 계정을 만든다.
# ⚠️ 첫 기동 이후에 바꾸면 반영되지 않는다 — 볼륨에 이미 계정이 있다
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=harucut
DB_USERNAME=harucut
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# 생성: openssl rand -base64 48   (바꾸면 발급된 토큰이 전부 무효)
JWT_SECRET_KEY=

# ── 쿠키 · 프론트 ─────────────────────────────────────────────
# api.harucut.com 과 harucut.com 이 쿠키를 나눠 쓰려면 상위 도메인으로
COOKIE_DOMAIN=harucut.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# 소셜 로그인 후 돌아갈 곳
FRONTEND_URL=https://harucut.com

# ── 메일 (Gmail SMTP) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=
# Google 계정 → 보안 → 앱 비밀번호 (16자리). 로그인 비밀번호로는 거부된다
MAIL_PASSWORD=
# MAIL_USERNAME 과 같게. 다르면 Gmail 이 어차피 로그인 주소로 바꿔 보낸다
MAIL_FROM=

# ── 소셜 로그인 ───────────────────────────────────────────────
# 각 콘솔에 리다이렉트 URI 등록: https://api.harucut.com/login/oauth2/code/{google|kakao|naver}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 로그인용 secret 과 다른 키. 탈퇴 배치의 연결 끊기(unlink)에 쓴다
KAKAO_ADMIN_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AWS ───────────────────────────────────────────────────────
# SDK 표준 변수명이라 철자를 바꾸면 인식 안 된다
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 둘 다 비면 기동에서 죽는다 (LambdaComposeExecutor, ComposeResultConsumer)
COMPOSE_LAMBDA_FUNCTION=
COMPOSE_RESULT_QUEUE_URL=

# ── 결제 ──────────────────────────────────────────────────────
# 아직 실제 PG 연동 전이라 mock. 실결제를 열 때 반드시 바꿀 것
PAYMENT_GATEWAY_PROVIDER=mock
# prod 프로필은 mock 게이트웨이면 기동을 거부한다(MockGatewayGuard). 이 값이 그 가드를 연다.
# ⚠️ 실제 PG 를 붙이는 날 이 줄을 반드시 지울 것 — 남아 있으면 가드가 없는 것과 같다
PAYMENT_MOCK_ALLOWED=true
PAYMENT_GRACE_DAYS=3

# ── Swagger ───────────────────────────────────────────────────
# 프론트 연동 중엔 켜둔다. 공개 출시 전에 false 로 — 안 끄면 API 명세가 인증 없이 열린다
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
